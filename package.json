{
  "name": "vognary",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10.9.7 <11"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "perf:lighthouse": "node scripts/check-lighthouse.mjs",
    "perf:motion": "node scripts/check-motion-budget.mjs",
    "load:gate": "node scripts/check-load-budget.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --conditions=react-server --import=tsx --test tests/*.test.ts",
    "test:postgres": "NODE_ENV=test node --conditions=react-server --import=tsx --test --test-force-exit tests/postgres/*.test.ts",
    "test:e2e": "playwright test",
    "proof:finops-control": "NODE_ENV=test node --conditions=react-server --import=tsx scripts/run-finops-control-proof.ts",
    "corpus": "node --conditions=react-server --import=tsx scripts/check-statement-corpus.ts",
    "corpus:strict": "node --conditions=react-server --import=tsx scripts/check-statement-corpus.ts --strict",
    "receipt-corpus": "node --conditions=react-server --import=tsx scripts/check-receipt-corpus.ts",
    "receipt-corpus:strict": "node --conditions=react-server --import=tsx scripts/check-receipt-corpus.ts --strict",
    "claims:check": "node scripts/check-public-claims.mjs",
    "funnel": "node --env-file-if-exists=.env.local scripts/report-funnel.mjs",
    "market:report": "node scripts/report-market-test.mjs",
    "market:cohort-gate": "node scripts/report-market-test.mjs --require-cohorts",
    "company-mail:forward": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.company-mail.local scripts/forward-company-mail.mjs",
    "security:inbox": "node --env-file-if-exists=.env.local scripts/report-security-inbox.mjs",
    "research:check": "node scripts/check-research-content-pack.mjs",
    "brand:build": "node scripts/generate-brand-assets.mjs",
    "brand:check": "node scripts/check-brand-assets.mjs",
    "tokens:check": "node scripts/check-design-tokens.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "ci": "npm run lint && npm run typecheck && npm run claims:check && npm run research:check && npm run brand:check && npm run tokens:check && npm run test && npm run build && npm run perf:budget && npm run perf:lighthouse && npm run perf:motion",
    "ci:database": "npm run db:apply-schema && npm run test:postgres",
    "ops:preflight": "node --env-file-if-exists=.env.production.local scripts/check-ops-preflight.mjs",
    "control:preflight": "node --env-file-if-exists=.env.production.local --import=tsx scripts/check-control-pilot-readiness.mjs",
    "production:check": "node --env-file-if-exists=.env.production.local scripts/check-production-activation.mjs",
    "release:gate": "node --env-file-if-exists=.env.production.local scripts/check-release-gate.mjs",
    "partner-rails:check": "node scripts/check-partner-rails.mjs",
    "core-connectors:check": "node scripts/check-core-connectors.mjs",
    "monitoring:test": "node scripts/check-monitoring-delivery.mjs",
    "billing:reconcile": "node --import=tsx scripts/reconcile-billing.ts",
    "billing:recover-checkout": "node --conditions=react-server --import=tsx scripts/recover-razorpay-checkout.ts",
    "billing:audit-order": "node --conditions=react-server --import=tsx scripts/update-assisted-audit.ts",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "backup:restore-drill": "node scripts/restore-postgres-drill.mjs",
    "db:apply-schema": "node scripts/apply-postgres-schema.mjs",
    "db:apply-production-0056": "node scripts/apply-production-0056.mjs",
    "db:apply-production-0057": "node scripts/apply-production-0057.mjs",
    "db:migrate-legacy-recovery": "node --conditions=react-server --import=tsx scripts/migrate-legacy-recovery.ts",
    "secrets:generate-backup-key": "node scripts/generate-backup-encryption-key.mjs",
    "secrets:generate-token-key": "node scripts/generate-token-encryption-key.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "html-to-text": "^10.0.0",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "next": "16.3.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "postal-mime": "^2.7.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "svix": "^1.99.1",
    "tailwindcss": "^4.3.2",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "22.20.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "lighthouse": "^13.4.1",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@5": "5.0.9",
    "deepmerge-ts": "8.0.1",
    "dompurify": "3.4.13",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
