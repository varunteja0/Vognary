# Public app URL used by hosted deployments and OAuth callback configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional waitlist persistence. Without this, /api/waitlist accepts preview leads but does not persist them.
WAITLIST_WEBHOOK_URL=

# Optional private audit intake persistence. Falls back to WAITLIST_WEBHOOK_URL when unset.
AUDIT_INTAKE_WEBHOOK_URL=

# Optional payment links. Without these, /api/checkout returns a not-configured response.
PAYMENT_LINK_PERSONAL_PRO=
PAYMENT_LINK_FOUNDER_PRO=
PAYMENT_LINK_TEAM=
PAYMENT_LINK_ANNUAL_AUDIT=

# Gmail read-only receipt discovery. Requires Google OAuth verification before public use.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Future persistent backend. Schema exists in infra/postgres/schema.sql; application wiring is staged next.
DATABASE_URL=postgres://vognary:vognary@localhost:5432/vognary
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_CA_CERT=
POSTGRES_POOL_MAX=5
# Generate with: npm run secrets:generate-token-key
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
PRIVATE_BETA_ACCESS_CODE=
INTERNAL_SYNC_SECRET=

# Future identity provider / magic-link delivery.
AUTH_PROVIDER=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
RESEND_API_KEY=

# Future shared rate limiting and production ops.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
AXIOM_TOKEN=
BETTER_STACK_SOURCE_TOKEN=
BACKUP_STORAGE_BUCKET=
S3_BUCKET=
R2_BUCKET=

# Future connector credentials. Prefer per-workspace encrypted token storage over global env vars for production.
OPENAI_ADMIN_API_KEY=
ANTHROPIC_ADMIN_API_KEY=
CLOUDFLARE_API_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
AWS_COST_EXPLORER_ROLE_ARN=

# Optional generic connector webhook verification. Prefer connector-specific secrets when providers are enabled.
CONNECTOR_WEBHOOK_SECRET=
CONNECTOR_WEBHOOK_SECRET_OPENAI_COSTS=

# Partner rails are not credentials; use these as operational status markers after contracts/sandboxes exist.
ACCOUNT_AGGREGATOR_PARTNER_STATUS=
UPI_MANDATE_PARTNER_STATUS=
CARD_MANDATE_PARTNER_STATUS=