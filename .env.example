# Public app URL used by hosted deployments and OAuth callback configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional waitlist persistence. Without this, /api/waitlist accepts preview leads but does not persist them.
WAITLIST_WEBHOOK_URL=

# Optional private audit intake persistence. Falls back to WAITLIST_WEBHOOK_URL when unset.
AUDIT_INTAKE_WEBHOOK_URL=

# Tracked Razorpay checkout for the one-time INR 999 assisted audit. The amount,
# offer version, and terms version are server-owned; no environment price or
# static fallback link is exposed. Leave legal status blank until qualified
# counsel approves the current paid terms.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Keep the previous secret only during a documented rotation window so retried
# older events can still be validated, then remove it.
RAZORPAY_WEBHOOK_OLD_SECRET=
ASSISTED_AUDIT_LEGAL_TERMS_STATUS=
# Local/non-production provider proof only. Never set this in production.
ASSISTED_AUDIT_CHECKOUT_MODE=
# Set these only after the corresponding live-account/provider proof is attached
# to the launch record. Strings alone are operator attestations, not evidence.
RAZORPAY_ACCOUNT_STATUS=
RAZORPAY_WEBHOOK_PROOF_STATUS=
RAZORPAY_REPLAY_PROOF_STATUS=
RAZORPAY_REFUND_PROOF_STATUS=
RAZORPAY_RECONCILIATION_STATUS=

# Gmail read-only receipt discovery. Requires Google OAuth verification before public use.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GOOGLE_OAUTH_VERIFICATION_COMPLETE=

# Google sign-in. Basic OpenID scopes only; separate from Gmail receipt access.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_AUTH_ALLOWED_EMAILS=
GOOGLE_AUTH_ALLOWED_DOMAIN=

# Persistent backend for sessions, encrypted workspace state, normalized ledger rows, and connector jobs.
DATABASE_URL=postgres://vognary:vognary@localhost:5432/vognary
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_CA_CERT=
POSTGRES_POOL_MAX=5
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
# Generate with: npm run secrets:generate-token-key
TOKEN_ENCRYPTION_KEY=
SESSION_SECRET=
# Optional issuer signing for authenticated audit-pack exports. The private
# key must be Ed25519 PKCS#8 (PEM, escaped PEM, or base64 DER). Keep old public
# SPKI keys in the JSON registry after rotation so historical packs verify.
AUDIT_PACK_SIGNING_PRIVATE_KEY=
AUDIT_PACK_SIGNING_KEY_ID=
AUDIT_PACK_TRUSTED_PUBLIC_KEYS={}
# Optional local/test-only identity. This route is hard-disabled in production
# and the access code is bound to exactly this email address.
ENABLE_DEVELOPMENT_LOGIN=false
DEVELOPMENT_LOGIN_EMAIL=
DEVELOPMENT_LOGIN_ACCESS_CODE=
# Optional local/test-only provider diagnostic. Always disabled in production.
ENABLE_ENV_CONNECTOR_PREVIEW=false
INTERNAL_SYNC_SECRET=
# Operator-only alias used by read-only production probes when the target secret
# differs from the local development secret. Do not deploy this additional name.
PRODUCTION_INTERNAL_SYNC_SECRET=
# Bearer secret automatically attached by Vercel Cron to scheduled GET workers.
CRON_SECRET=
# Operator evidence flags. Leave blank until the matching runbook stop
# condition is proven in the deployed environment; code or secrets alone are
# not production activation evidence.
RENEWAL_ALERT_DELIVERY_STATUS=
RETENTION_SCHEDULER_STATUS=

# Resend delivery for magic links and explicitly opted-in renewal alerts.
# (Identity providers are Google OIDC + magic link; see the GOOGLE_* block.)
RESEND_API_KEY=
ENABLE_MAGIC_LINK_LOGIN=false
RESEND_FROM_EMAIL=

# Receipt forwarding is separately gated from outbound email. Use a
# least-privilege receiving key and a dedicated subdomain such as
# receipts.vognary.com. The HMAC secret must decode to exactly 32 bytes.
ENABLE_RECEIPT_INBOX=false
RESEND_RECEIVING_API_KEY=
RESEND_INBOUND_WEBHOOK_SECRET=
RESEND_RECEIVING_DOMAIN=
RECEIPT_INBOX_ALIAS_HMAC_SECRET=
RECEIPT_INBOX_ALIAS_HMAC_KEY_ID=receipt-alias-v1
RECEIPT_INBOX_PROVIDER_STATUS=
RECEIPT_INBOX_WEBHOOK_PROOF_STATUS=
RECEIPT_INBOX_REPLAY_PROOF_STATUS=
RECEIPT_INBOX_RETENTION_REVIEW_STATUS=

# Optional high-scale Redis backend and production ops. A migrated DATABASE_URL
# automatically provides shared Postgres rate limiting when Upstash is absent.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Production fails closed unless Postgres or Upstash provides a shared backend.
ALLOW_IN_MEMORY_RATE_LIMITS=false
SENTRY_DSN=
AXIOM_TOKEN=
BETTER_STACK_SOURCE_TOKEN=
# Sends a synthetic event through /api/internal/monitoring/test when INTERNAL_SYNC_SECRET is available.
MONITORING_DELIVERY_TEST_STATUS=
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_FINGERPRINT=
BACKUP_DIR=backups/postgres
BACKUP_STORAGE_BUCKET=
S3_BUCKET=
R2_BUCKET=
BACKUP_STORAGE_ENDPOINT=
BACKUP_STORAGE_REGION=
BACKUP_STORAGE_ACCESS_KEY_ID=
BACKUP_STORAGE_SECRET_ACCESS_KEY=
BACKUP_STORAGE_PREFIX=vognary-postgres/
BACKUP_RESTORE_DRILL_STATUS=
# ISO date of the last successful restore drill (set together with the status
# attestation, only after an observed drill); shown on the public trust pages.
BACKUP_RESTORE_DRILL_AT=
RESTORE_DATABASE_URL=
RESTORE_CONFIRM_DISPOSABLE=false

# Release-gate database. This must identify a disposable non-production
# database and must never equal DATABASE_URL.
RELEASE_DATABASE_URL=
RELEASE_POSTGRES_SSL=
RELEASE_CONFIRM_DISPOSABLE=false

# Vognary's own AI layer (extraction on Haiku, narration on Sonnet — see
# src/lib/server/ai/models.ts). Absent key = the product runs deterministic-only
# and says so honestly. The monthly cap is enforced in INR by
# src/lib/server/ai/budget.ts before any model call.
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_INR=

# Local/test connector preview credentials only. Never configure a deployment-wide
# provider key in production; production connectors use per-workspace encrypted tokens.
OPENAI_ADMIN_API_KEY=
ANTHROPIC_ADMIN_API_KEY=
CLOUDFLARE_API_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
AWS_COST_EXPLORER_ROLE_ARN=

# Optional generic connector webhook verification. Prefer connector-specific secrets when providers are enabled.
CONNECTOR_WEBHOOK_SECRET=
CONNECTOR_WEBHOOK_SECRET_OPENAI_COSTS=

# Partner rails are not credentials. Use only exact values from docs/partner-rails-access-playbook.md.
# Strict production readiness requires all three to be production-live.
ACCOUNT_AGGREGATOR_PARTNER_STATUS=
UPI_MANDATE_PARTNER_STATUS=
CARD_MANDATE_PARTNER_STATUS=

# Setu Account Aggregator FIU keys (sandbox keys are self-serve on bridge.setu.co;
# production keys require the signed agreement tracked above).
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
SETU_AA_PRODUCT_INSTANCE_ID=
SETU_AA_BASE_URL=https://fiu-sandbox.setu.co
# Optional: must be registered with the AA provider. Defaults to APP_URL/app?aa=returned.
SETU_AA_REDIRECT_URI=
# Optional: use only a tag already configured on the Setu product instance.
SETU_AA_TAG=
