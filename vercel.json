{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/internal/renewal-alerts/due/run",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/internal/privacy/retention/run",
      "schedule": "30 21 * * *"
    }
  ]
}
